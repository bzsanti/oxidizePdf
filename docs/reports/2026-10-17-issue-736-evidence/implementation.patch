diff --git a/oxidize-pdf-core/tests/issue_736_png_depth_test.rs b/oxidize-pdf-core/tests/issue_736_png_depth_test.rs
new file mode 100644
index 00000000..f3594ca9
--- /dev/null
+++ b/oxidize-pdf-core/tests/issue_736_png_depth_test.rs
@@ -0,0 +1,220 @@
+#![cfg(feature = "external-images")]
+use image::{ExtendedColorType, ImageEncoder};
+use oxidize_pdf::parser::{ParseOptions, PdfReader};
+use oxidize_pdf::{Document, Image, Page};
+use std::io::Cursor;
+fn png16(color: ExtendedColorType, samples: &[u16]) -> Vec<u8> {
+    let native: Vec<u8> = samples.iter().flat_map(|s| s.to_ne_bytes()).collect();
+    let mut bytes = Vec::new();
+    image::codecs::png::PngEncoder::new(&mut bytes)
+        .write_image(&native, 2, 1, color)
+        .unwrap();
+    let independent = image::load_from_memory_with_format(&bytes, image::ImageFormat::Png).unwrap();
+    assert_eq!(independent.as_bytes(), native);
+    bytes
+}
+fn be(samples: &[u16]) -> Vec<u8> {
+    samples.iter().flat_map(|s| s.to_be_bytes()).collect()
+}
+fn cases() -> Vec<(ExtendedColorType, Vec<u16>, Vec<u16>, Option<Vec<u16>>)> {
+    vec![
+        (
+            ExtendedColorType::L16,
+            vec![0x1234, 0xabcd],
+            vec![0x1234, 0xabcd],
+            None,
+        ),
+        (
+            ExtendedColorType::La16,
+            vec![0x1234, 0, 0xabcd, 0xffff],
+            vec![0x1234, 0xabcd],
+            Some(vec![0, 0xffff]),
+        ),
+        (
+            ExtendedColorType::Rgb16,
+            vec![0x1234, 0x5678, 0x9abc, 0xabcd, 0xdef0, 0x0123],
+            vec![0x1234, 0x5678, 0x9abc, 0xabcd, 0xdef0, 0x0123],
+            None,
+        ),
+        (
+            ExtendedColorType::Rgba16,
+            vec![
+                0x1234, 0x5678, 0x9abc, 0x2468, 0xabcd, 0xdef0, 0x0123, 0xffff,
+            ],
+            vec![0x1234, 0x5678, 0x9abc, 0xabcd, 0xdef0, 0x0123],
+            Some(vec![0x2468, 0xffff]),
+        ),
+    ]
+}
+#[test]
+fn grayscale_16_bit_sample_boundaries_and_metadata() {
+    let img = Image::from_png_data(png16(ExtendedColorType::L16, &[0x1234, 0xabcd])).unwrap();
+    assert_eq!(img.bits_per_component(), 16);
+    assert_eq!(img.data(), &[0x12, 0x34, 0xab, 0xcd]);
+}
+#[test]
+fn rgb_and_alpha_samples_keep_all_sixteen_bits() {
+    for (color, samples, expected, alpha) in cases() {
+        let img = Image::from_png_data(png16(color, &samples)).unwrap();
+        assert_eq!(img.bits_per_component(), 16, "{color:?}");
+        assert_eq!(img.data(), be(&expected), "{color:?}");
+        assert_eq!(
+            img.alpha_data().map(<[u8]>::to_vec),
+            alpha.as_ref().map(|a| be(a)),
+            "{color:?}"
+        );
+        if let Some(alpha) = alpha {
+            let mask = img.soft_mask().unwrap();
+            assert_eq!(mask.bits_per_component(), 16);
+            assert_eq!(mask.data(), be(&alpha));
+        } else {
+            assert!(img.soft_mask().is_none());
+        }
+    }
+}
+#[test]
+fn eight_bit_gray_rgb_and_alpha_controls() {
+    for (color, samples, expected, alpha) in [
+        (
+            ExtendedColorType::L8,
+            vec![0x12, 0xab],
+            vec![0x12, 0xab],
+            None,
+        ),
+        (
+            ExtendedColorType::La8,
+            vec![0x12, 0, 0xab, 255],
+            vec![0x12, 0xab],
+            Some(vec![0, 255]),
+        ),
+        (
+            ExtendedColorType::Rgb8,
+            vec![1, 2, 3, 4, 5, 6],
+            vec![1, 2, 3, 4, 5, 6],
+            None,
+        ),
+        (
+            ExtendedColorType::Rgba8,
+            vec![1, 2, 3, 0, 4, 5, 6, 255],
+            vec![1, 2, 3, 4, 5, 6],
+            Some(vec![0, 255]),
+        ),
+    ] {
+        let mut png = Vec::new();
+        image::codecs::png::PngEncoder::new(&mut png)
+            .write_image(&samples, 2, 1, color)
+            .unwrap();
+        let img = Image::from_png_data(png).unwrap();
+        assert_eq!(img.bits_per_component(), 8);
+        assert_eq!(img.data(), expected);
+        assert_eq!(img.alpha_data().map(<[u8]>::to_vec), alpha);
+    }
+}
+fn written_pdf(img: Image) -> Vec<u8> {
+    let mut page = Page::new(100., 100.);
+    page.add_image("Sample", img);
+    page.draw_image("Sample", 0., 0., 20., 10.).unwrap();
+    let mut doc = Document::new();
+    doc.add_page(page);
+    doc.to_bytes().unwrap()
+}
+fn reopened(bytes: &[u8], expected: &[u8], alpha: Option<&[u8]>) -> Vec<(u32, Vec<u8>)> {
+    let doc = PdfReader::new(Cursor::new(bytes)).unwrap().into_document();
+    let page = doc.get_page(0).unwrap();
+    let resources = doc.get_page_resources(&page).unwrap().unwrap();
+    let xobjects = doc.resolve(resources.get("XObject").unwrap()).unwrap();
+    let object = xobjects.as_dict().unwrap().0.values().next().unwrap();
+    let id = object.as_reference().unwrap().0;
+    let main = doc.resolve(object).unwrap();
+    let main = main.as_stream().unwrap();
+    assert_eq!(
+        main.dict.get("BitsPerComponent").unwrap().as_integer(),
+        Some(16)
+    );
+    assert_eq!(main.decode(&ParseOptions::default()).unwrap(), expected);
+    let mut objects = vec![(id, expected.to_vec())];
+    if let Some(alpha) = alpha {
+        let reference = main.dict.get("SMask").unwrap();
+        let id = reference.as_reference().unwrap().0;
+        let mask = doc.resolve(reference).unwrap();
+        let mask = mask.as_stream().unwrap();
+        assert_eq!(
+            mask.dict.get("BitsPerComponent").unwrap().as_integer(),
+            Some(16)
+        );
+        assert_eq!(mask.decode(&ParseOptions::default()).unwrap(), alpha);
+        objects.push((id, alpha.to_vec()));
+    }
+    objects
+}
+#[test]
+fn written_and_reopened_pdf_preserves_main_and_mask_samples() {
+    for (color, samples, expected, alpha) in cases() {
+        let pdf = written_pdf(Image::from_png_data(png16(color, &samples)).unwrap());
+        reopened(
+            &pdf,
+            &be(&expected),
+            alpha.as_ref().map(|a| be(a)).as_deref(),
+        );
+    }
+}
+#[test]
+#[ignore = "requires qpdf; explicitly run in interoperability CI"]
+fn independent_qpdf_decodes_written_sixteen_bit_streams() {
+    let dir = tempfile::tempdir().unwrap();
+    for (index, (color, samples, expected, alpha)) in cases().into_iter().enumerate() {
+        let pdf = written_pdf(Image::from_png_data(png16(color, &samples)).unwrap());
+        let objects = reopened(
+            &pdf,
+            &be(&expected),
+            alpha.as_ref().map(|a| be(a)).as_deref(),
+        );
+        let path = dir.path().join(format!("image-{index}.pdf"));
+        std::fs::write(&path, pdf).unwrap();
+        for (id, expected) in objects {
+            let output = std::process::Command::new("qpdf")
+                .arg(format!("--show-object={id}"))
+                .arg("--filtered-stream-data")
+                .arg(&path)
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "{}",
+                String::from_utf8_lossy(&output.stderr)
+            );
+            assert_eq!(output.stdout, expected);
+            let dictionary = std::process::Command::new("qpdf")
+                .arg(format!("--show-object={id}"))
+                .arg(&path)
+                .output()
+                .unwrap();
+            assert!(dictionary.status.success());
+            assert!(String::from_utf8(dictionary.stdout)
+                .unwrap()
+                .contains("/BitsPerComponent 16"));
+        }
+    }
+}
+
+#[test]
+fn oversized_sixteen_bit_geometry_returns_error_without_panicking() {
+    let mut png = png16(ExtendedColorType::Rgba16, &[0; 8]);
+    png[16..20].copy_from_slice(&0x7fff_ffffu32.to_be_bytes());
+    png[20..24].copy_from_slice(&0x7fff_ffffu32.to_be_bytes());
+    let mut crc = 0xffff_ffffu32;
+    for &byte in &png[12..29] {
+        crc ^= u32::from(byte);
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 {
+                (crc >> 1) ^ 0xedb8_8320
+            } else {
+                crc >> 1
+            };
+        }
+    }
+    png[29..33].copy_from_slice(&(!crc).to_be_bytes());
+    let result = std::panic::catch_unwind(|| Image::from_png_data(png));
+    assert!(result.is_ok(), "invalid large image must not panic");
+    assert!(result.unwrap().is_err());
+}
